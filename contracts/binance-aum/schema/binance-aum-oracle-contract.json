{
  "contract_name": "binance-aum-oracle-contract",
  "contract_version": "0.1.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "consensus_data_valid_period",
      "data_delta_ppm",
      "oracles",
      "owner",
      "price_data_valid_period",
      "price_oracle_contract",
      "required_binance_positions",
      "required_binance_spot_assets",
      "round_length",
      "threshold"
    ],
    "properties": {
      "consensus_data_valid_period": {
        "description": "Initial validity period for data in seconds",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "data_delta_ppm": {
        "description": "Delta in percent per million (ppm), for which two values are considered equal",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "oracles": {
        "description": "A list of oracles allowed to publish data",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "owner": {
        "description": "Owner of the contract",
        "type": "string"
      },
      "price_data_valid_period": {
        "description": "Initial validity period for data in blocks",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "price_oracle_contract": {
        "description": "Price oracle contract address",
        "type": "string"
      },
      "required_binance_positions": {
        "description": "Required binance positions that oracles must provide",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "required_binance_spot_assets": {
        "description": "Required binance spot assets that oracles must provide",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "round_length": {
        "description": "Consensus round length in seconds",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "threshold": {
        "description": "Initial threshold for consensus.",
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "PublishData allows a registered oracle to submit new Binance data. This message triggers the consensus check and updates `last_published_data` if consensus is reached.",
        "type": "object",
        "required": [
          "publish_data"
        ],
        "properties": {
          "publish_data": {
            "type": "object",
            "required": [
              "new_data"
            ],
            "properties": {
              "new_data": {
                "$ref": "#/definitions/BinanceData"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "UpdateConfig updates the contract's configuration parameters. Only callable by the admin. All fields are optional, allowing partial updates.",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "type": "object",
            "required": [
              "new_config"
            ],
            "properties": {
              "new_config": {
                "$ref": "#/definitions/UpdateConfig"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "BinanceData": {
        "type": "object",
        "required": [
          "pm_account_actual_equity",
          "positions",
          "spot_balances",
          "um_balance_usdt",
          "unimmr",
          "withdrawable_usdt"
        ],
        "properties": {
          "pm_account_actual_equity": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Position"
            }
          },
          "spot_balances": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SpotBalance"
            }
          },
          "um_balance_usdt": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "unimmr": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "withdrawable_usdt": {
            "$ref": "#/definitions/SignedDecimal256"
          }
        },
        "additionalProperties": false
      },
      "Position": {
        "type": "object",
        "required": [
          "amount",
          "pnl",
          "symbol"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "pnl": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "symbol": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SignedDecimal256": {
        "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
        "type": "string"
      },
      "SpotBalance": {
        "type": "object",
        "required": [
          "amount",
          "asset"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "asset": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateConfig": {
        "type": "object",
        "properties": {
          "consensus_data_valid_period": {
            "description": "New validity period for the consensus (in seconds)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "data_delta_ppm": {
            "description": "A new data delta for the consensus",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "oracles": {
            "description": "A new list of oracles that are allowed to publish data",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "description": "New owner address",
            "type": [
              "string",
              "null"
            ]
          },
          "price_data_valid_period": {
            "description": "New validity period for price oracle (in blocks)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "price_oracle_contract": {
            "description": "New price oracle contract address",
            "type": [
              "string",
              "null"
            ]
          },
          "required_binance_positions": {
            "description": "New required binance positions",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "required_binance_spot_assets": {
            "description": "New required binance spot assets",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "round_length": {
            "description": "A new rounds length (in seconds)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "threshold": {
            "description": "A new threshold value for the consensus",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "description": "Returns the latest published data",
        "type": "object",
        "required": [
          "get_data"
        ],
        "properties": {
          "get_data": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns the latest total AUM in Binance reported by oracles",
        "type": "object",
        "required": [
          "get_aum"
        ],
        "properties": {
          "get_aum": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns current round info",
        "type": "object",
        "required": [
          "get_round_info"
        ],
        "properties": {
          "get_round_info": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": null,
  "sudo": null,
  "responses": {
    "get_aum": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetAumResponse",
      "type": "object",
      "required": [
        "aum_in_btc"
      ],
      "properties": {
        "aum_in_btc": {
          "description": "The latest AUM in Binance reported by oracles The value is in micro-Bitcoin (uwBTC) = 1wBTC = 100000000 uwBTC",
          "allOf": [
            {
              "$ref": "#/definitions/Int256"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Int256": {
          "description": "An implementation of i256 that is using strings for JSON encoding/decoding, such that the full i256 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances out of primitive uint types or `new` to provide big endian bytes:\n\n``` # use cosmwasm_std::Int256; let a = Int256::from(258u128); let b = Int256::new([ 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, ]); assert_eq!(a, b); ```",
          "type": "string"
        }
      }
    },
    "get_data": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetDataResponse",
      "type": "object",
      "properties": {
        "last_published_data": {
          "description": "The latest published data (can be null if there was no consensus reached)",
          "anyOf": [
            {
              "$ref": "#/definitions/OracleData_for_BinanceData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "BinanceData": {
          "type": "object",
          "required": [
            "pm_account_actual_equity",
            "positions",
            "spot_balances",
            "um_balance_usdt",
            "unimmr",
            "withdrawable_usdt"
          ],
          "properties": {
            "pm_account_actual_equity": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "positions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Position"
              }
            },
            "spot_balances": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SpotBalance"
              }
            },
            "um_balance_usdt": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "unimmr": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "withdrawable_usdt": {
              "$ref": "#/definitions/SignedDecimal256"
            }
          },
          "additionalProperties": false
        },
        "OracleData_for_BinanceData": {
          "description": "Data submitted by an oracle",
          "type": "object",
          "required": [
            "data",
            "round",
            "timestamp"
          ],
          "properties": {
            "data": {
              "description": "The data submitted by the oracle",
              "allOf": [
                {
                  "$ref": "#/definitions/BinanceData"
                }
              ]
            },
            "round": {
              "description": "The round number an oracle tries to submit data for",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "timestamp": {
              "description": "The UNIX timestamp in seconds when the oracle submitted the data",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        "Position": {
          "type": "object",
          "required": [
            "amount",
            "pnl",
            "symbol"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "pnl": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "symbol": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "SignedDecimal256": {
          "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
          "type": "string"
        },
        "SpotBalance": {
          "type": "object",
          "required": [
            "amount",
            "asset"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "asset": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "get_round_info": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RoundInfoResponse",
      "type": "object",
      "required": [
        "next_round",
        "pending_round"
      ],
      "properties": {
        "next_round": {
          "description": "The next round",
          "allOf": [
            {
              "$ref": "#/definitions/Round"
            }
          ]
        },
        "pending_round": {
          "description": "Currently pending round",
          "allOf": [
            {
              "$ref": "#/definitions/Round"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Round": {
          "description": "Describes the round entity",
          "type": "object",
          "required": [
            "round",
            "start"
          ],
          "properties": {
            "round": {
              "description": "a number of the round",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "start": {
              "description": "when the round started (UNIX timestamp in seconds)",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
