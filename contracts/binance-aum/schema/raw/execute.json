{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "PublishData allows a registered oracle to submit new Binance data. This message triggers the consensus check and updates `last_published_data` if consensus is reached.",
      "type": "object",
      "required": [
        "publish_data"
      ],
      "properties": {
        "publish_data": {
          "type": "object",
          "required": [
            "new_data"
          ],
          "properties": {
            "new_data": {
              "$ref": "#/definitions/BinanceData"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "UpdateConfig updates the contract's configuration parameters. Only callable by the admin. All fields are optional, allowing partial updates.",
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "required": [
            "new_config"
          ],
          "properties": {
            "new_config": {
              "$ref": "#/definitions/UpdateConfig"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "BinanceData": {
      "type": "object",
      "required": [
        "pm_account_actual_equity",
        "positions",
        "spot_balances",
        "um_balance_usdt",
        "unimmr",
        "withdrawable_usdt"
      ],
      "properties": {
        "pm_account_actual_equity": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Position"
          }
        },
        "spot_balances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpotBalance"
          }
        },
        "um_balance_usdt": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "unimmr": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "withdrawable_usdt": {
          "$ref": "#/definitions/SignedDecimal256"
        }
      },
      "additionalProperties": false
    },
    "Position": {
      "type": "object",
      "required": [
        "amount",
        "pnl",
        "symbol"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "pnl": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SignedDecimal256": {
      "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
      "type": "string"
    },
    "SpotBalance": {
      "type": "object",
      "required": [
        "amount",
        "asset"
      ],
      "properties": {
        "amount": {
          "$ref": "#/definitions/SignedDecimal256"
        },
        "asset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "UpdateConfig": {
      "type": "object",
      "properties": {
        "consensus_data_valid_period": {
          "description": "New validity period for the consensus (in seconds)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "data_delta_ppm": {
          "description": "A new data delta for the consensus",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "oracles": {
          "description": "A new list of oracles that are allowed to publish data",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "description": "New owner address",
          "type": [
            "string",
            "null"
          ]
        },
        "price_data_valid_period": {
          "description": "New validity period for price oracle (in blocks)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "price_oracle_contract": {
          "description": "New price oracle contract address",
          "type": [
            "string",
            "null"
          ]
        },
        "required_binance_positions": {
          "description": "New required binance positions",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "required_binance_spot_assets": {
          "description": "New required binance spot assets",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "round_length": {
          "description": "A new rounds length (in seconds)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "threshold": {
          "description": "A new threshold value for the consensus",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
