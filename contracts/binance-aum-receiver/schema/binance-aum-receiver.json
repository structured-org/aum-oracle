{
  "contract_name": "binance-aum-receiver",
  "contract_version": "0.1.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "consensus_data_valid_period",
      "data_delta_ppm",
      "messengers",
      "owner",
      "price_data_valid_period",
      "price_oracle_contract",
      "required_binance_positions",
      "required_binance_spot_assets",
      "round_length",
      "threshold"
    ],
    "properties": {
      "consensus_data_valid_period": {
        "description": "Initial validity period for data (that reached consensus) in the contract in seconds. If the data is too old, Binance AUM contract cannot rely on it in AUM calculations, and in that case the contract just doesn't calculate AUM and returns an error in the corresponding query.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "data_delta_ppm": {
        "description": "Delta in percent per million (ppm), for which two values are considered equal",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "messengers": {
        "description": "A list of messengers allowed to publish data",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "owner": {
        "description": "Owner of the contract",
        "type": "string"
      },
      "price_data_valid_period": {
        "description": "Initial validity period for prices from the oracle contract in blocks. If the prices are too old, Binance AUM contract cannot rely on them in AUM calculations, and in that case the contract just doesn't calculate AUM and returns an error in the corresponding query.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "price_oracle_contract": {
        "description": "Price oracle contract address",
        "type": "string"
      },
      "required_binance_positions": {
        "description": "Required binance positions that messengers must provide",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "required_binance_spot_assets": {
        "description": "Required binance spot assets that messengers must provide",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "round_length": {
        "description": "Consensus round length in seconds",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "threshold": {
        "description": "Initial threshold for consensus.",
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Allows a registered messenger to submit new Binance data. This message triggers the consensus check and updates `last_published_data` if consensus is reached.",
        "type": "object",
        "required": [
          "publish_data"
        ],
        "properties": {
          "publish_data": {
            "type": "object",
            "required": [
              "new_data"
            ],
            "properties": {
              "new_data": {
                "$ref": "#/definitions/BinanceData"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Updates the contract's configuration parameters. Only callable by the owner. All fields are optional, allowing partial updates.",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "type": "object",
            "required": [
              "new_config"
            ],
            "properties": {
              "new_config": {
                "$ref": "#/definitions/UpdateConfig"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ],
    "definitions": {
      "BinanceData": {
        "type": "object",
        "required": [
          "pm_account_actual_equity",
          "positions",
          "spot_balances",
          "um_balance_usdt",
          "unimmr",
          "withdrawable_usdt"
        ],
        "properties": {
          "pm_account_actual_equity": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Position"
            }
          },
          "spot_balances": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/SpotBalance"
            }
          },
          "um_balance_usdt": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "unimmr": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "withdrawable_usdt": {
            "$ref": "#/definitions/SignedDecimal256"
          }
        },
        "additionalProperties": false
      },
      "Position": {
        "type": "object",
        "required": [
          "amount",
          "pnl",
          "symbol"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "pnl": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "symbol": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SignedDecimal256": {
        "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
        "type": "string"
      },
      "SpotBalance": {
        "type": "object",
        "required": [
          "amount",
          "asset"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/SignedDecimal256"
          },
          "asset": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateConfig": {
        "type": "object",
        "properties": {
          "consensus_data_valid_period": {
            "description": "New validity period for the consensus (in seconds)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "data_delta_ppm": {
            "description": "A new data delta for the consensus",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "messengers": {
            "description": "A new list of messengers that are allowed to publish data",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "description": "New owner address",
            "type": [
              "string",
              "null"
            ]
          },
          "price_data_valid_period": {
            "description": "New validity period for price oracle (in blocks)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "price_oracle_contract": {
            "description": "New price oracle contract address",
            "type": [
              "string",
              "null"
            ]
          },
          "required_binance_positions": {
            "description": "New required binance positions",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "required_binance_spot_assets": {
            "description": "New required binance spot assets",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "round_length": {
            "description": "A new rounds length (in seconds)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0.0
          },
          "threshold": {
            "description": "A new threshold value for the consensus",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "oneOf": [
      {
        "description": "Returns the latest published data",
        "type": "object",
        "required": [
          "get_data"
        ],
        "properties": {
          "get_data": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns the latest total AUM in Binance reported by messengers. Returns an error if published data by messengers are too old, or token prices reported by Slinky are too old",
        "type": "object",
        "required": [
          "get_aum"
        ],
        "properties": {
          "get_aum": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns current round info",
        "type": "object",
        "required": [
          "get_round_info"
        ],
        "properties": {
          "get_round_info": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Returns the current configuration of the contract and it's consensus mechanism",
        "type": "object",
        "required": [
          "get_config"
        ],
        "properties": {
          "get_config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": null,
  "sudo": null,
  "responses": {
    "get_aum": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetAumResponse",
      "type": "object",
      "required": [
        "aum_in_btc",
        "decimals"
      ],
      "properties": {
        "aum_in_btc": {
          "description": "The latest AUM in Binance reported by messengers",
          "allOf": [
            {
              "$ref": "#/definitions/Int256"
            }
          ]
        },
        "decimals": {
          "description": "Represents the number of decimals that the aum_in_btc is represented in. It is used to scale the aum_in_btc to its base BTC value. E.g. `base_aum_in_btc = aum_in_btc / 10^decimals`",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Int256": {
          "description": "An implementation of i256 that is using strings for JSON encoding/decoding, such that the full i256 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances out of primitive uint types or `new` to provide big endian bytes:\n\n``` # use cosmwasm_std::Int256; let a = Int256::from(258u128); let b = Int256::new([ 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 2u8, ]); assert_eq!(a, b); ```",
          "type": "string"
        }
      }
    },
    "get_config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetConfigResponse",
      "type": "object",
      "required": [
        "consensus_config",
        "contract_config"
      ],
      "properties": {
        "consensus_config": {
          "description": "The current config of the consensus mechanism",
          "allOf": [
            {
              "$ref": "#/definitions/Config"
            }
          ]
        },
        "contract_config": {
          "description": "The current config of the contract itself",
          "allOf": [
            {
              "$ref": "#/definitions/Config2"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Addr": {
          "description": "A human readable address.\n\nIn Cosmos, this is typically bech32 encoded. But for multi-chain smart contracts no assumptions should be made other than being UTF-8 encoded and of reasonable length.\n\nThis type represents a validated address. It can be created in the following ways 1. Use `Addr::unchecked(input)` 2. Use `let checked: Addr = deps.api.addr_validate(input)?` 3. Use `let checked: Addr = deps.api.addr_humanize(canonical_addr)?` 4. Deserialize from JSON. This must only be done from JSON that was validated before such as a contract's state. `Addr` must not be used in messages sent by the user because this would result in unvalidated instances.\n\nThis type is immutable. If you really need to mutate it (Really? Are you sure?), create a mutable copy using `let mut mutable = Addr::to_string()` and operate on that `String` instance.",
          "type": "string"
        },
        "Config": {
          "description": "Describes the configuration of consensus",
          "type": "object",
          "required": [
            "data_delta_ppm",
            "messengers",
            "round_length",
            "threshold"
          ],
          "properties": {
            "data_delta_ppm": {
              "description": "delta in percent per million (ppm), for which two values are considered equal",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "messengers": {
              "description": "a list of messengers that can submit data for consensus",
              "type": "array",
              "items": {
                "$ref": "#/definitions/Addr"
              }
            },
            "round_length": {
              "description": "length of a round in seconds",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "threshold": {
              "description": "threshold of the consensus (how many messengers must submit data for consensus to be reached)",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        "Config2": {
          "type": "object",
          "required": [
            "consensus_data_valid_period",
            "owner",
            "price_data_valid_period",
            "price_oracle_contract",
            "required_binance_positions",
            "required_binance_spot_assets"
          ],
          "properties": {
            "consensus_data_valid_period": {
              "description": "Validity period for data (that reached consensus) in the contract in seconds. If the data is too old, Binance AUM contract cannot rely on it in AUM calculations, and in that case the contract just doesn't calculate AUM and returns an error in the corresponding query.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "owner": {
              "description": "owner of the contract",
              "allOf": [
                {
                  "$ref": "#/definitions/Addr"
                }
              ]
            },
            "price_data_valid_period": {
              "description": "Validity period for prices from the oracle contract in blocks. If the prices are too old, Binance AUM contract cannot rely on them in AUM calculations, and in that case the contract just doesn't calculate AUM and returns an error in the corresponding query.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "price_oracle_contract": {
              "description": "address of price oracle contract",
              "allOf": [
                {
                  "$ref": "#/definitions/Addr"
                }
              ]
            },
            "required_binance_positions": {
              "description": "required binance positions that messengers must provide",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_binance_spot_assets": {
              "description": "required binance spot assets that messengers must provide",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "get_data": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetDataResponse",
      "type": "object",
      "properties": {
        "last_published_data": {
          "description": "The latest published data (can be null if there was no consensus reached)",
          "anyOf": [
            {
              "$ref": "#/definitions/OracleData_for_BinanceData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "BinanceData": {
          "type": "object",
          "required": [
            "pm_account_actual_equity",
            "positions",
            "spot_balances",
            "um_balance_usdt",
            "unimmr",
            "withdrawable_usdt"
          ],
          "properties": {
            "pm_account_actual_equity": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "positions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Position"
              }
            },
            "spot_balances": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SpotBalance"
              }
            },
            "um_balance_usdt": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "unimmr": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "withdrawable_usdt": {
              "$ref": "#/definitions/SignedDecimal256"
            }
          },
          "additionalProperties": false
        },
        "OracleData_for_BinanceData": {
          "description": "Data submitted by a messenger",
          "type": "object",
          "required": [
            "data",
            "round",
            "timestamp"
          ],
          "properties": {
            "data": {
              "description": "The data submitted by the messenger",
              "allOf": [
                {
                  "$ref": "#/definitions/BinanceData"
                }
              ]
            },
            "round": {
              "description": "The round number a messenger tries to submit data for",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "timestamp": {
              "description": "The UNIX timestamp in seconds when the messenger submitted the data",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        "Position": {
          "type": "object",
          "required": [
            "amount",
            "pnl",
            "symbol"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "pnl": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "symbol": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "SignedDecimal256": {
          "description": "A signed fixed-point decimal value with 18 fractional digits, i.e. SignedDecimal256(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 57896044618658097711785492504343953926634992332820282019728.792003956564819967 (which is (2^255 - 1) / 10^18) and the smallest is -57896044618658097711785492504343953926634992332820282019728.792003956564819968 (which is -2^255 / 10^18).",
          "type": "string"
        },
        "SpotBalance": {
          "type": "object",
          "required": [
            "amount",
            "asset"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/SignedDecimal256"
            },
            "asset": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "get_round_info": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RoundInfoResponse",
      "type": "object",
      "required": [
        "next_round",
        "pending_round"
      ],
      "properties": {
        "next_round": {
          "description": "The next round",
          "allOf": [
            {
              "$ref": "#/definitions/Round"
            }
          ]
        },
        "pending_round": {
          "description": "Currently pending round",
          "allOf": [
            {
              "$ref": "#/definitions/Round"
            }
          ]
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Round": {
          "description": "Describes the round entity",
          "type": "object",
          "required": [
            "round",
            "start"
          ],
          "properties": {
            "round": {
              "description": "a number of the round",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "start": {
              "description": "when the round started (UNIX timestamp in seconds)",
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
