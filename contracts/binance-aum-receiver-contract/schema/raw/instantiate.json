{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "consensus_data_valid_period",
    "data_delta_ppm",
    "messengers",
    "owner",
    "price_data_valid_period",
    "price_oracle_contract",
    "required_binance_positions",
    "required_binance_spot_assets",
    "round_length",
    "threshold"
  ],
  "properties": {
    "consensus_data_valid_period": {
      "description": "Initial validity period for data in seconds",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "data_delta_ppm": {
      "description": "Delta in percent per million (ppm), for which two values are considered equal",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "messengers": {
      "description": "A list of messengers allowed to publish data",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "description": "Owner of the contract",
      "type": "string"
    },
    "price_data_valid_period": {
      "description": "Initial validity period for data in blocks",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "price_oracle_contract": {
      "description": "Price oracle contract address",
      "type": "string"
    },
    "required_binance_positions": {
      "description": "Required binance positions that messengers must provide",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_binance_spot_assets": {
      "description": "Required binance spot assets that messengers must provide",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "round_length": {
      "description": "Consensus round length in seconds",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "threshold": {
      "description": "Initial threshold for consensus.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
